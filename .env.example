NEXT_PUBLIC_MP_PUBLIC_KEY="APP_USR-..."
MP_ACCESS_TOKEN="APP_USR-..."
APP_URL="https://payments-unihousing.vercel.app"
SELLER_APP_URL="https://payments-unihousing.vercel.app"
BUYER_APP_URL="https://payments-unihousing.vercel.app"
SHIPPING_APP_URL="https://payments-unihousing.vercel.app"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Prisma — Supabase PostgreSQL
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# Fee de plataforma (porcentaje como decimal, ej: 0.05 = 5%)
PLATFORM_FEE_RATE=0.05

# Shared secret entre apps del ecosistema UniHousing (se envia hasheado en tránsito)
INTERNAL_API_KEY=
